{
  "name": "spora-ai/spora-plugin-zernio",
  "description": "Zernio social-media scheduling and publishing for Spora agents.",
  "type": "spora-plugin",
  "license": "MIT",
  "require": {
    "php": "^8.4.1",
    "spora-ai/spora-core": ">=0.15.0 <2.0.0 || @dev"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^5.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-mockery": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Spora\\Plugins\\Zernio\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Spora\\Plugins\\Zernio\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "lint": "php-cs-fixer fix --dry-run --diff --no-interaction"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "spora-ai/installer": true
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../spora-core",
      "options": {
        "symlink": true
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}